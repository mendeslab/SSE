<project name="beast-config">
  <property environment="env"/>
  <property name="beast.jar" location="${env.BEAST_HOME}/lib/packages/BEAST.base.jar"/>
  <property name="launcher.jar" location="${env.BEAST_HOME}/lib/launcher.jar"/>
  <property name="beast.app.jar" location="${env.BEAST_HOME}/lib/packages/BEAST.app.jar"/>
  <property name="beast.version" location="${env.BEAST_HOME}/lib/packages/BEAST.base.version.xml"/>
  <property name="beast.app.version" location="${env.BEAST_HOME}/lib/packages/BEAST.app.version.xml"/>
  <property name="junit.download" location="build/test-libs/junit-platform-console-standalone-1.8.2.jar"/>
  <property name="junit.jar" location="${junit.download}"/>
  <property name="test.services" location="build/test-services"/>

  <!-- Check only targets that need BEAST; help, clean and JUnit downloads remain independent. -->
  <target name="check-beast-home">
    <fail message="Set BEAST_HOME to a BEAST installation containing bin/ and lib/.">
      <condition><or>
        <not><isset property="env.BEAST_HOME"/></not>
        <equals arg1="${env.BEAST_HOME}" arg2=""/>
        <not><available file="${env.BEAST_HOME}" type="dir"/></not>
      </or></condition>
    </fail>
  </target>

  <target name="show-config" depends="check-beast-home" description="Show BEAST paths and package versions">
    <echo>BEAST_HOME: ${env.BEAST_HOME}
Base jar: ${beast.jar}
Launcher: ${launcher.jar}
App jar: ${beast.app.jar}
Base metadata: ${beast.version}
App metadata: ${beast.app.version}
JUnit: ${junit.jar}
Set BEAST_HOME to an installation containing bin/ and lib/.</echo>
    <xmlproperty file="${beast.version}" prefix="base.info"/>
    <xmlproperty file="${beast.app.version}" prefix="app.info"/>
    <echo>BEAST.base: ${base.info.package(version)}; BEAST.app: ${app.info.package(version)}</echo>
  </target>

  <target name="prepare-base-services" depends="check-beast-home">
    <fail message="BEAST.base metadata not found: ${beast.version}. Check BEAST_HOME.">
      <condition><not><available file="${beast.version}"/></not></condition>
    </fail>
    <!-- Empty lib directories let BEAST's JUnit service discovery find the parent version.xml.
         This adapts installed metadata filenames to JUnit discovery, not package installation. -->
    <mkdir dir="${test.services}/BEAST.base/lib"/>
    <mkdir dir="${test.services}/biogeo/lib"/>
    <copy file="${beast.version}" tofile="${test.services}/BEAST.base/version.xml" overwrite="true"/>
    <copy file="version.xml" tofile="${test.services}/biogeo/version.xml" overwrite="true"/>
  </target>

  <target name="fetch-test-deps" description="Explicitly download and verify the test-only JUnit jar">
    <mkdir dir="build/test-libs"/>
    <get src="https://repo.maven.apache.org/maven2/org/junit/platform/junit-platform-console-standalone/1.8.2/junit-platform-console-standalone-1.8.2.jar"
         dest="${junit.download}" skipexisting="true"/>
    <checksum file="${junit.download}" algorithm="SHA-256" property="junit.sha256"/>
    <fail message="JUnit checksum mismatch. Remove the downloaded file and retry fetch-test-deps.">
      <condition><not><equals arg1="${junit.sha256}"
        arg2="dc498f234228f81c818becfb6b7f71f73df2b0e995f93f25c05fced0c77e6356"/></not></condition>
    </fail>
  </target>

  <!-- Share resolved paths between the command-line launcher and IDE instructions.
       Absolute, quoted arguments allow launching from another directory, including spaces. -->
  <target name="prepare-launch" depends="check-beast-home" description="Write standard Java launcher arguments without compiling">
    <fail message="Missing BEAST launch dependency; inspect ant show-config.">
      <condition><not><and>
        <available file="${launcher.jar}"/><available file="${beast.jar}"/>
        <available file="${beast.app.jar}"/><available file="${beast.version}"/>
        <available file="${beast.app.version}"/>
      </and></not></condition>
    </fail>
    <pathconvert property="launch.classpath">
      <path>
        <pathelement location="${build}"/>
        <path refid="compile.classpath"/>
        <pathelement location="${launcher.jar}"/>
        <pathelement location="${beast.app.jar}"/>
      </path>
    </pathconvert>
    <property name="launch.base.version" location="${beast.version}"/>
    <property name="launch.app.version" location="${beast.app.version}"/>
    <mkdir dir="build"/>
    <echo file="build/beast.args">-cp
"${launch.classpath}"
beast.pkgmgmt.launcher.BeastLauncher
-version_file
"${launch.base.version}"
-version_file
"${launch.app.version}"
-version_file
"${basedir}/version.xml"
</echo>
  </target>

  <target name="prepare-run" depends="compile,prepare-launch"/>

  <target name="show-ide" depends="prepare-launch" description="Show IDE classpath and program arguments">
    <loadfile property="launch.arguments" srcfile="build/beast.args"/>
    <echo>${launch.arguments}
In the IDE, replace the SSE build classpath entry with the IDE's output directory.
Use your run directory as the working directory; append the XML path to the program arguments.</echo>
  </target>
</project>
