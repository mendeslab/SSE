# Gaussian speciation at a fixed origin age. Run from the SSE repository with pjcli on PATH.
# pjcli examples/quasse-sim-v3.pj --runs 100 -d -r 1601797 -o /tmp/quasse-sim-v3
origin_age <- 9

# rate_scale is the geometric mean of the center and tail rates, with prior median 0.65.
# contrast is the log center-to-tail rate ratio. Positive values give peaks and negative values give troughs.
rate_scale ~ lognormal(meanlog=log(0.65), sdlog=0.3)
contrast ~ normal(mean=0, sd=log(2))
center_rate := rate_scale * exp(contrast/2)
baseline := rate_scale * exp(-contrast/2)
rate_ratio := center_rate / baseline
center ~ normal(mean=0, sd=3)
width ~ lognormal(meanlog=log(5), sdlog=0.5)
birth := quasse_gaussian(baseline=baseline, center_rate=center_rate, center=center, width=width)

mu_rate <- 0.13
psi_rate <- 0
death := quasse_constant(rate=mu_rate)
fossil := quasse_constant(rate=psi_rate)

# Brownian diffusion variance is the squared trait SD per unit square-root time.
diffusion_sd ~ lognormal(meanlog=1.0, sdlog=0.3)
diffusion_variance := diffusion_sd * diffusion_sd
initial := normal(mean=0, sd=1)
observation_sd <- 0.1

# Retry extinct histories at the same parameters. A failed tip-count condition redraws the model.
tree ~ quasse(birth_rate=birth, death_rate=death, fossil_rate=fossil, start_distribution=initial, drift=0, diffusion=diffusion_variance, stop="age", stop_value=origin_age, sampling_prob=1, cond_surv=true, observation_sd=observation_sd, method="local_thinning", block_duration=1, reject_above=5000)
n := n_extant_tips(tree)
condition(100 <= n && n <= 300)
