<?xml version="1.0" encoding="UTF-8"?>
<beast version="2.7"
       namespace="beast.base.core:beast.base.inference:beast.base.inference.distribution:beast.base.inference.operator:beast.base.evolution.tree:SSE">
  <!-- Use scripts/generate_quasse_xml.py with origin=origin_age and
       observationSD=observation_sd bindings. The one-tip data below are placeholders.
       This model matches QuaSSE_zhang2024_fixed_origin.pj with no fossils.
       Priors use natural-log means and standard deviations. -->
  <parameter id="origin" spec="parameter.RealParameter" value="7.75"/>
  <parameter id="observationSD" spec="parameter.RealParameter" value="0.1"/>
  <tree id="observedTree" spec="TreeParser" newick="A;" IsLabelledNewick="true"
        adjustTipHeights="false" threshold="1e-8" singlechild="false" binarizeMultifurcations="false">
    <taxonset spec="beast.base.evolution.alignment.TaxonSet">
      <taxon id="A" spec="beast.base.evolution.alignment.Taxon"/>
    </taxonset>
  </tree>
  <parameter id="observations" spec="parameter.RealParameter" keys="A" value="0.0"/>
  <function id="lambda" spec="beast.base.inference.util.RPNcalculator"
            expression="diversification 1 turnover - /">
    <parameter idref="diversification"/><parameter idref="turnover"/>
  </function>
  <function id="mu" spec="beast.base.inference.util.RPNcalculator" expression="turnover lambda *">
    <parameter idref="turnover"/><parameter idref="lambda"/>
  </function>
  <function id="diffusionVar" spec="beast.base.inference.util.RPNcalculator" expression="diffusionSD diffusionSD *">
    <parameter idref="diffusionSD"/>
  </function>
  <run id="mcmc" spec="MCMC" chainLength="100">
    <state id="state">
      <!-- These finite values permit model construction. PriorInitialiser draws starting values
           from the priors at run time, independently of simulation truth. -->
      <stateNode id="diversification" spec="parameter.RealParameter" lower="0" value="0.52"/>
      <stateNode id="turnover" spec="parameter.RealParameter" lower="0" upper="1" value="0.2"/>
      <stateNode id="diffusionSD" spec="parameter.RealParameter" lower="0" value="2.72"/>
    </state>
    <init spec="SSE.PriorInitialiser" state="@state" prior="@prior"/>
    <distribution id="posterior" spec="CompoundDistribution">
      <distribution id="prior" spec="CompoundDistribution">
        <distribution spec="Prior" x="@diversification">
          <distr spec="LogNormalDistributionModel" M="-0.65" S="0.1" meanInRealSpace="false"/>
        </distribution>
        <distribution spec="Prior" x="@turnover"><distr spec="Beta" alpha="10" beta="40"/></distribution>
        <distribution spec="Prior" x="@diffusionSD">
          <distr spec="LogNormalDistributionModel" M="1.0" S="0.3" meanInRealSpace="false"/>
        </distribution>
      </distribution>
      <distribution id="likelihood" spec="QuaSSEDistribution" tree="@observedTree"
                    conditionOnRoot="false" origin="@origin" conditionOnSampling="false"
                    conditionOnRhoSampling="true" fossilSamplingRate="0" presentSamplingProbability="1"
                    fftBackend="sst" integrationBackend="java">
        <startTraitDistribution spec="Normal" mean="0" sigma="1"/>
        <q2mLambda spec="ConstantLinkFn" yV="@lambda"/>
        <q2mMu spec="ConstantLinkFn" yV="@mu"/>
        <q2d spec="NormalCenteredAtObservedLinkFn" quTraits="@observations" sdNormalQuTrValue="@observationSD"/>
        <grid id="grid" spec="QuaSSEGrid" origin="@origin" traits="@observations" drift="0"
              diffusion="@diffusionVar" nX="4096" dtMax="0.01"/>
        <dynDt spec="parameter.BooleanParameter" value="true"/>
      </distribution>
    </distribution>
    <operator spec="beast.base.evolution.operator.ScaleOperator" parameter="@diversification"
              scaleFactor="0.9" weight="1"/>
    <operator spec="beast.base.evolution.operator.ScaleOperator" parameter="@turnover"
              scaleFactor="0.9" weight="1"/>
    <operator spec="beast.base.evolution.operator.ScaleOperator" parameter="@diffusionSD"
              scaleFactor="0.9" weight="1"/>
    <logger id="trace" fileName="replicate.log" logEvery="10" model="@posterior">
      <log idref="posterior"/><log idref="likelihood"/><log idref="prior"/>
      <log idref="diversification"/><log idref="turnover"/><log idref="diffusionSD"/>
      <log idref="lambda"/><log idref="mu"/><log idref="diffusionVar"/>
    </logger>
  </run>
</beast>
