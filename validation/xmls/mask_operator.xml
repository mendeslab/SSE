<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<beast namespace="beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.inference.parameter:beast.base.inference.util:beast.base.inference.distribution:beast.base.evolution:beast.base.evolution.alignment:beast.base.evolution.tree:beast.base.evolution.operator" required="" version="2.7">

  <run id="mcmc" spec="MCMC" chainLength="1000000">
    <state id="state" storeEvery="1">
      <stateNode idref="StateMask"/>
      <stateNode idref="CIDMask"/>
    </state>

    <distribution id="posterior" spec="CompoundDistribution">   
      
      <!-- START prior -->
      <distribution id="prior" spec="CompoundDistribution">
        <distribution id="DummyPrior" spec="Prior" x="@StateMask">
          <distr id="DummyPriorStateMask" spec="Uniform" lower="0" upper="2">
          </distr>
        </distribution>
        
        <distribution id="DummyPrior2" spec="Prior" x="@CIDMask">
          <distr id="DummyPriorCIDMask" spec="Uniform" lower="0" upper="1">
          </distr>
        </distribution>
      </distribution>
      <!-- END prior -->
      
      <!-- START likelihood -->
      <distribution id="likelihood" spec="CompoundDistribution">
	    <distribution id="MaskOperatorDist" spec="SSE.MaskOperatorDist">        
	  	  <stateMask id="StateMask" dimension="3" spec="IntegerParameter">0 0 0</stateMask>
	  	  <cidMask id="CIDMask" dimension="1" spec="IntegerParameter">0</cidMask>
        </distribution>
      </distribution>
      <!-- END likelihood -->

    </distribution> <!-- END Posterior -->

    <operator id="StateMaskOperator" spec="operators.StateMaskOperator" mask="@StateMask" weight="1.0"/>
    <operator id="CIDMaskOperator" spec="operators.CIDMaskOperator" mask="@CIDMask" weight="1.0"/>

    <logger id="tracelog" fileName="mask_operator.log" logEvery="1" model="@posterior" sanitiseHeaders="true" sort="smart">
        <log idref="StateMask"/>
        <log idref="CIDMask"/>
    </logger>

  </run>
</beast>
