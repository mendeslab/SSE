<project default="compile" basedir=".">

  <!-- CONFIGURATION: Source, JUnit test code and jar library locations. -->
  <property name="src" location="src"/>
  <property name="test" location="test"/>
  <property name="lib" location="lib"/>

  <property name="javaVersion" value="17"/>
  <property environment="env"/>
  <property name="beast.jar" location="${env.BEAST_HOME}/lib/packages/BEAST.base.jar"/>
  <property name="launcher.jar" location="${env.BEAST_HOME}/lib/launcher.jar"/>
  <property name="beast.app.jar" location="${env.BEAST_HOME}/lib/packages/BEAST.app.jar"/>
  <property name="beast.version" location="${env.BEAST_HOME}/lib/packages/BEAST.base.version.xml"/>
  <property name="beast.app.version" location="${env.BEAST_HOME}/lib/packages/BEAST.app.version.xml"/>
  <property name="junit.download" location="build/test-libs/junit-platform-console-standalone-1.8.2.jar"/>
  <property name="junit.jar" location="${junit.download}"/>
  <property name="test.services" location="build/test-services"/>
  <property name="classpath" value=""/>
  <!--*******************************************************************-->

  <!-- Directories necessary for all BEAST 2 packages -->
  <property name="examples" location="examples"/>

  <!-- Names of temporary build/test directories -->
  <property name="build" location="build"/>
  <property name="build-test" location="build-test"/>
  <property name="test-reports" location="test-reports"/>
  <property name="dist" location="dist"/>
  <property name="pack" location="${dist}/package"/>

  <path id="compile.classpath">
    <pathelement path="${classpath}"/>
    <pathelement location="${beast.jar}"/>
    <fileset dir="${lib}" includes="*.jar"/>
  </path>

  <path id="test.classpath">
    <path refid="compile.classpath"/>
    <pathelement location="${build}"/>
    <pathelement location="${build-test}"/>
    <pathelement location="${launcher.jar}"/>
    <pathelement location="${junit.jar}"/>
    <pathelement location="${test.services}/BEAST.base/lib"/>
    <pathelement location="${test.services}/biogeo/lib"/>
  </path>

  <!-- Check only targets that need BEAST; help, clean and JUnit downloads remain independent. -->
  <target name="check-beast-home">
    <fail message="Set BEAST_HOME to a BEAST installation containing bin/ and lib/.">
      <condition><or>
        <not><isset property="env.BEAST_HOME"/></not>
        <equals arg1="${env.BEAST_HOME}" arg2=""/>
        <not><available file="${env.BEAST_HOME}" type="dir"/></not>
      </or></condition>
    </fail>
  </target>

  <target name="show-config" depends="check-beast-home" description="Show BEAST paths and package versions">
    <echo>BEAST_HOME: ${env.BEAST_HOME}
Base jar: ${beast.jar}
Launcher: ${launcher.jar}
App jar: ${beast.app.jar}
Base metadata: ${beast.version}
App metadata: ${beast.app.version}
JUnit: ${junit.jar}
Set BEAST_HOME to an installation containing bin/ and lib/.</echo>
    <xmlproperty file="${beast.version}" prefix="base.info"/>
    <xmlproperty file="${beast.app.version}" prefix="app.info"/>
    <echo>BEAST.base: ${base.info.package(version)}; BEAST.app: ${app.info.package(version)}</echo>
  </target>

  <target name="prepare-base-services" depends="check-beast-home">
    <fail message="BEAST.base metadata not found: ${beast.version}. Check BEAST_HOME.">
      <condition><not><available file="${beast.version}"/></not></condition>
    </fail>
    <!-- Empty lib directories let BEAST's JUnit service discovery find the parent version.xml.
         This adapts installed metadata filenames to JUnit discovery, not package installation. -->
    <mkdir dir="${test.services}/BEAST.base/lib"/>
    <mkdir dir="${test.services}/biogeo/lib"/>
    <copy file="${beast.version}" tofile="${test.services}/BEAST.base/version.xml" overwrite="true"/>
    <copy file="version.xml" tofile="${test.services}/biogeo/version.xml" overwrite="true"/>
  </target>

  <target name="fetch-test-deps" description="Explicitly download and verify the test-only JUnit jar">
    <mkdir dir="build/test-libs"/>
    <get src="https://repo.maven.apache.org/maven2/org/junit/platform/junit-platform-console-standalone/1.8.2/junit-platform-console-standalone-1.8.2.jar"
         dest="${junit.download}" skipexisting="true"/>
    <checksum file="${junit.download}" algorithm="SHA-256" property="junit.sha256"/>
    <fail message="JUnit checksum mismatch. Remove the downloaded file and retry fetch-test-deps.">
      <condition><not><equals arg1="${junit.sha256}"
        arg2="dc498f234228f81c818becfb6b7f71f73df2b0e995f93f25c05fced0c77e6356"/></not></condition>
    </fail>
  </target>

  <!-- Share resolved paths between the command-line launcher and IDE instructions.
       Absolute, quoted arguments allow launching from another directory, including spaces. -->
  <target name="prepare-launch" depends="check-beast-home" description="Write standard Java launcher arguments without compiling">
    <fail message="Missing BEAST launch dependency; inspect ant show-config.">
      <condition><not><and>
        <available file="${launcher.jar}"/><available file="${beast.jar}"/>
        <available file="${beast.app.jar}"/><available file="${beast.version}"/>
        <available file="${beast.app.version}"/>
      </and></not></condition>
    </fail>
    <pathconvert property="launch.classpath">
      <path>
        <pathelement location="${build}"/>
        <path refid="compile.classpath"/>
        <pathelement location="${launcher.jar}"/>
        <pathelement location="${beast.app.jar}"/>
      </path>
    </pathconvert>
    <property name="launch.base.version" location="${beast.version}"/>
    <property name="launch.app.version" location="${beast.app.version}"/>
    <mkdir dir="build"/>
    <echo file="build/beast.args">-cp
"${launch.classpath}"
beast.pkgmgmt.launcher.BeastLauncher
-version_file
"${launch.base.version}"
-version_file
"${launch.app.version}"
-version_file
"${basedir}/version.xml"
</echo>
  </target>

  <target name="prepare-run" depends="compile,prepare-launch"/>

  <target name="show-ide" depends="prepare-launch" description="Show IDE classpath and program arguments">
    <loadfile property="launch.arguments" srcfile="build/beast.args"/>
    <echo>${launch.arguments}
In the IDE, replace the SSE build classpath entry with the IDE's output directory.
Use your run directory as the working directory; append the XML path to the program arguments.</echo>
  </target>

  <!-- Prepare for compilation -->
  <target name="init" depends="check-beast-home">

    <available file="version.xml" property="versionAvailable"/>
    <fail unless="versionAvailable">
      ** Required file version.xml does not exist. **
    </fail>

    <!-- Read package name and version from xml file -->
    <xmlproperty file="version.xml" prefix="fromVersionFile" />
    <property name="projName" value="${fromVersionFile.package(name)}" />
    <property name="projVersion" value="${fromVersionFile.package(version)}" />

    <mkdir dir="${build}"/>

    <available file="${beast.jar}" property="beastAvailable"/>
    <fail unless="beastAvailable">
      ** BEAST.base.jar was not found at ${beast.jar}. **
      Check BEAST_HOME (the installation containing bin/ and lib/).
    </fail>
  </target>

  <!-- Compile the active SSE sources without packaging them in a jar. -->
  <target name="compile" depends="init">
    <javac release="${javaVersion}" srcdir="${src}" destdir="${build}" includeantruntime="false"
           includes="SSE/**/*.java,loggers/**/*.java,operators/**/*.java,mosse/**/*.java">
      <classpath refid="compile.classpath"/>
    </javac>
  </target>

  
  <!-- Prepare for unit test compilation -->
  <target name="init-test" depends="init,prepare-base-services">
    <mkdir dir="${build-test}"/>
    <mkdir dir="${test-reports}"/>

    <available file="${launcher.jar}" property="launcherAvailable"/>
    <fail unless="launcherAvailable">
      ** BEAST launcher.jar was not found at ${launcher.jar}. **
      Check BEAST_HOME (the installation containing bin/ and lib/).
    </fail>

    <available file="${junit.jar}" property="junitAvailable"/>
    <fail unless="junitAvailable">
      ** JUnit was not found at ${junit.jar}. **
      Run ant fetch-test-deps, or supply -Djunit.jar=/path/to/junit.jar.
    </fail>
  </target>


  <!-- Compile unit tests -->
  <target name="compile-test" depends="init-test,compile">
    <javac release="${javaVersion}" srcdir="${src}" destdir="${build-test}" includeantruntime="false"
           includes="test/**/*.java,drivers/**/*.java,validation/**/*.java">
      <classpath refid="test.classpath"/>
    </javac>
    <javac release="${javaVersion}" srcdir="${test}" destdir="${build-test}" includeantruntime="false">
      <classpath refid="test.classpath"/>
    </javac>
  </target>


  <!-- Run unit tests -->
  <target name="test" depends="compile-test">
    <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true"
          dir="${basedir}" maxmemory="1g">
      <classpath refid="test.classpath"/>
      <arg value="--disable-banner"/>
      <arg value="--details=summary"/>
      <arg value="--reports-dir=${test-reports}"/>
      <arg value="--select-package=test"/>
    </java>
  </target>

  <!-- MoSSE tests require the separately built FFTW JNI library. -->
  <target name="test-mosse" depends="compile-test">
    <available file="${basedir}/jni/libtest.so" property="mosseNativeAvailable"/>
    <fail unless="mosseNativeAvailable">
      ** MoSSE JNI library was not found at ${basedir}/jni/libtest.so. **
      Run "make -C jni" before running the MoSSE tests.
    </fail>
    <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true"
          dir="${basedir}" maxmemory="1g">
      <classpath refid="test.classpath"/>
      <jvmarg value="-Djava.library.path=${basedir}/jni"/>
      <arg value="--disable-banner"/>
      <arg value="--details=summary"/>
      <arg value="--reports-dir=${test-reports}/mosse"/>
      <arg value="--select-package=mosse"/>
    </java>
  </target>

  <target name="test-all" depends="test-mosse,test"/>


  <!-- Create BEAST 2 package -->
  <target name="build" depends="compile">
    <property name="fullName" value="${projName}.v${projVersion}"/>

    <mkdir dir="${pack}"/>
    <mkdir dir="${pack}/examples"/>
    <mkdir dir="${pack}/lib"/>

    <jar jarfile="${pack}/${fullName}.src.jar" basedir="${src}" />

    <mkdir dir="${lib}" />
    <copy todir="${pack}/lib">
      <fileset dir="${lib}" includes="*.jar" />
    </copy>
    <!-- build also holds launch settings and diagnostics; ship only production classes. -->
    <jar jarfile="${pack}/lib/${fullName}.jar" basedir="${build}"
         includes="SSE/**/*.class,loggers/**/*.class,operators/**/*.class,mosse/**/*.class" />

    <copy file="README.md" tofile="${pack}/README" />
    <copy file="COPYING.md" todir="${pack}" />
    <copy todir="${pack}">
      <fileset dir="${lib}" includes="LICENSE*" />
    </copy>

    <copy todir="${pack}/examples">
      <fileset dir="${examples}" includes="*.xml" />
      <fileset dir="${examples}" includes="*.fna" />
    </copy>

    <copy file="version.xml" todir="${pack}" />

    <zip destfile="${dist}/${fullName}.zip" basedir="${pack}" />

    <delete dir="${pack}"/>

    <echo/>
    <echo/>
    <echo>** Package ${dist}/${fullName}.zip created successfuly! **</echo>
  </target>


  <!-- Revert to pristine state. -->
  <target name="clean">
    <delete dir="${build}" />
    <delete dir="${dist}" />
    <delete dir="${build-test}" />
    <delete dir="${test-reports}" />
  </target>


</project>
