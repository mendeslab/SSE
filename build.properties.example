# Usually set BEAST_HOME in your environment instead of creating build.properties.
# Root precedence: explicit -Dbeast.home / -Dbeast.dir, this file, BEAST_HOME, sibling sources.
# Uncomment ONE root selection if you want checkout-local configuration:
# beast.home=/path/to/beast
# beast.dir=/path/to/beast2
# beastfx.dir=/path/to/BeastFX
# Individual dependency paths may also be overridden:
# beast.jar=/path/to/BEAST.base.jar
# launcher.jar=/path/to/launcher.jar
# beast.app.jar=/path/to/BEAST.app.jar
# beast.version=/path/to/BEAST.base.version.xml
# beast.app.version=/path/to/BEAST.app.version.xml
# junit.jar=/path/to/junit-platform-console-standalone-1.8.2.jar
